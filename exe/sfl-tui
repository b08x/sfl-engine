#!/usr/bin/env ruby
# frozen_string_literal: true

# Running from a repo checkout (no gemspec), same as exe/sfl-analyze —
# bundler doesn't add this app's lib/ to the load path on its own.
lib = File.expand_path("../lib", __dir__)
$LOAD_PATH.unshift(lib) if File.directory?(lib) && !$LOAD_PATH.include?(lib)

require_relative "../lib/sfl"

# Everything that can write to the terminal runs BEFORE ratatui enters raw
# mode and the alternate screen: a stray write afterwards lands inside the
# frame. Docker's output and any boot failure are printed here or not at all.
SFL::DockerServices.ensure_running!(enabled: SFL::Boot.auto_start_docker?)

context = begin
  SFL::TUI::App.build
rescue SFL::Boot::Error => e
  warn("sfl-tui: #{e.message}")
  exit 1
end

SFL::TUI::App.run(context)
