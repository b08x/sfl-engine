# SFL Engine Environment Configuration

# SFL_API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SFL_TASK_PASS_TWO_ANNOTATION_MODEL=openrouter/minimax/minimax-m2.7
# SFL_TASK_PASS_TWO_BATCH_ANNOTATION_MODEL=openrouter/minimax/minimax-m2.7

# SFL_TASK_EMBEDDING_MODEL=embeddinggemma:latest

# Narrator for `sfl-analyze ... --narrative` (narrative_report.md). When unset it uses the
# context_synthesis task, which in turn uses the Pass 2 model. A small Pass 2 model can fail the
# narrative's structured output ("Prediction validation failed: Missing required properties"),
# so a reasoning model is configured here separately.
# Also accepted: SFL_TASK_NARRATIVE_GENERATION_TEMPERATURE (a number, or "none" to omit it),
# _SEED and _MAX_TOKENS.
# SFL_TASK_NARRATIVE_GENERATION_PROVIDER=openrouter
# SFL_TASK_NARRATIVE_GENERATION_MODEL=upstage/solar-pro4

# Raw exports for `rake eval:run_unseen` (defaults sit under ../Datasets and ~/NotebookLM)
# SFL_EVAL_CLAUDE_EXPORT=
# SFL_EVAL_CHATGPT_EXPORT=
# SFL_EVAL_MISTRAL_EXPORT=
# SFL_EVAL_NOTEBOOKLM_FILE=

# Logging: comma-separated list of targets (stderr, journald); default stderr.
# Example: SFL_LOG_TARGET=stderr,journald writes every log call to both targets.
# When journald is listed and /run/systemd/journal/socket is missing, startup raises Boot::Error.
# Minimum level: debug|info|warn|error|fatal
# SFL_LOG_TARGET=stderr
# SFL_LOG_LEVEL=info
# Run id attached to every log line (run_id=... on stderr, SFL_RUN_ID field in journald).
# Generated per process when unset. rake eval:run_unseen sets one id per item.
# Query one run: journalctl SFL_RUN_ID=<id>
# SFL_RUN_ID=
# The CLI always writes "progress turn=N total=M" to stderr after each finished turn,
# regardless of SFL_LOG_TARGET.
