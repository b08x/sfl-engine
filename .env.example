# SFL Engine Environment Configuration

# SFL_API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# true lets the API's 500 responses include the exception message. Never set it in production.
# SFL_API_DEBUG_ERRORS=false
# 1 lets sfl-analyze and sfl-tui run `docker compose up -d --wait` at startup. Read from the
# shell environment only, not from this file, because it is checked before .env is loaded.
# SFL_AUTO_START_DOCKER=1

# Rack app (config.ru / boot.rb). true skips LLM wiring at boot.
# SFL_SKIP_LLM_BOOT=false
# true configures Langfuse tracing at rack boot.
# SFL_ENABLE_TRACING=false

# Per-task models. A task's model is the SFL_TASK_<TASK>_MODEL variable when it is set,
# else the task's row in the task_models table (set in sfl-tui's Models tab), else the
# built-in default. A task set here is shown as locked in the Models tab.
# An LLM task with none of these set defaults to openrouter google/gemma-4-26b-a4b-it:free (zero-cost).
# SFL_TASK_PASS_TWO_ANNOTATION_MODEL=openrouter/minimax/minimax-m2.7
# SFL_TASK_PASS_TWO_BATCH_ANNOTATION_MODEL=openrouter/minimax/minimax-m2.7
# The loader_drafting task drafts candidate loaders for file shapes no loader
# recognizes. It defaults to the Pass 2 model (Boot::TaskModelResolver::DERIVED_DEFAULTS);
# set a chat-capable model here to override it.
# SFL_TASK_LOADER_DRAFTING_MODEL=

# The embedding task's provider and model. Defaults: ollama, embeddinggemma-2:440m.
# SFL_TASK_EMBEDDING_PROVIDER=ollama
# SFL_TASK_EMBEDDING_MODEL=embeddinggemma-2:440m
# Seconds one embedding request may take. Default 30.
# SFL_EMBEDDING_TIMEOUT_SECONDS=30
# The context_synthesis task also reads images for `--vision-model`; set a vision-capable model here.
# SFL_TASK_CONTEXT_SYNTHESIS_MODEL=

# `rake models:refresh` and the Models tab's `r` read the ruby_llm registry, Ollama's /api/tags at
# OLLAMA_BASE_URL (default http://tinybot:11434) and OpenRouter's /api/v1/models (sent
# OPENROUTER_API_KEY when it is set).
# OLLAMA_BASE_URL=http://tinybot:11434

# Narrator for `sfl-analyze ... --narrative` (narrative_report.md). When unset it uses the
# context_synthesis task, which in turn uses the Pass 2 model. A small Pass 2 model can fail the
# narrative's structured output ("Prediction validation failed: Missing required properties"),
# so a reasoning model is configured here separately.
# Also accepted: SFL_TASK_NARRATIVE_GENERATION_TEMPERATURE (a number, or "none" to omit it),
# _SEED and _MAX_TOKENS.
# SFL_TASK_NARRATIVE_GENERATION_PROVIDER=openrouter
# SFL_TASK_NARRATIVE_GENERATION_MODEL=upstage/solar-pro4
# Narrator signature: v0, v1 or v2. Default v1.
# SFL_NARRATIVE_VARIANT=v1

# Raw exports for `rake eval:run_unseen` (defaults sit under ../Datasets and ~/NotebookLM)
# SFL_EVAL_CLAUDE_EXPORT=
# SFL_EVAL_CHATGPT_EXPORT=
# SFL_EVAL_MISTRAL_EXPORT=
# SFL_EVAL_NOTEBOOKLM_FILE=

# Logging: comma-separated list of targets (stderr, journald); default stderr.
# Example: SFL_LOG_TARGET=stderr,journald writes every log call to both targets.
# When journald is listed and /run/systemd/journal/socket is missing, startup raises Boot::Error.
# Minimum level: debug|info|warn|error|fatal
# SFL_LOG_TARGET=stderr
# SFL_LOG_LEVEL=info
# Run id attached to every log line (run_id=... on stderr, SFL_RUN_ID field in journald).
# Generated per process when unset. rake eval:run_unseen sets one id per item.
# Query one run: journalctl SFL_RUN_ID=<id>
# SFL_RUN_ID=
# The CLI always writes "progress turn=N total=M" to stderr after each finished turn,
# regardless of SFL_LOG_TARGET.

# sfl-tui: review decisions are recorded under this name; without it they are refused.
# SFL_REVIEWER_NAME=
# sfl-tui: directory for Browse exports (<collection>-<timestamp>.jsonl|md). Default ./output/exports
# SFL_EXPORT_DIR=
# sfl-tui: the review editor is $VISUAL, else $EDITOR, else vi.
# sfl-tui: the `i` launcher runs `sfl-analyze ingest PATH --collection NAME [flags]`. Inside kitty it
# opens a new kitty tab. Outside kitty it starts a detached child that writes to
# <dir>/ingest-<run id>.log; follow the run on the Runs tab. Default ./output/logs
# SFL_INGEST_LOG_DIR=
# sfl-tui uses kitty (new tabs for the launcher, `kitten icat` for images) only when kitty sets
# KITTY_WINDOW_ID and KITTY_LISTEN_ON points at a reachable socket. kitty.conf needs
# `allow_remote_control yes` and `listen_on unix:/tmp/mykitty`. Do not set these by hand.
# Otherwise images open with xdg-open.

# Web app (config.ru / app/). RACK_ENV defaults to development.
# RACK_ENV=development
# Postgres for sfl-analyze, sfl-tui, rake db:migrate and the web app. Required in production. Outside
# production the web app falls back to postgres://user:password@localhost:5432/app_<RACK_ENV>.
# DATABASE_URL=postgres://user:password@localhost:5432/sfl
# Session cookie secret (at least 64 characters). Required when RACK_ENV=production; startup raises
# Boot::Error without it. Outside production a random secret is generated per process, so sessions
# do not survive a restart. Generate one with: ruby -rsecurerandom -e 'puts SecureRandom.hex(64)'
# SESSION_SECRET=
